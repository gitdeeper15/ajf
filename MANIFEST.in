include README.md
include LICENSE
include CHANGELOG.md
include CITATION.cff
include AUTHORS.md
include CONTRIBUTING.md
include requirements.txt
include VERSION

recursive-include ajf *.py
recursive-include DATA *.csv *.json
recursive-include PUBLICATION *.pdf
recursive-include docs *.md

prune .venv
prune .git
prune pycache
prune PUBLICATION
prune DATA
prune ANALYSIS
prune REPORTS
prune EXTERNAL_REVIEW
prune VALIDATION
prune docs
prune dist
prune build

global-exclude *.pyc
global-exclude *.pyo
