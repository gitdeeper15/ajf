"""Structured Evidence Judge using Groq API via requests."""
import os
import json
import requests
from ajf.judges.base_judge import BaseJudge
from typing import Dict, Any

class EvidenceJudge(BaseJudge):
    """Judge that verifies claims against execution evidence."""
    
    def __init__(self, model_name: str = "llama-3.3-70b-versatile"):
        self.model_name = model_name
        self.api_key = os.environ.get("GROQ_API_KEY", "")
        self.api_url = "https://api.groq.com/openai/v1/chat/completions"
    
    def evaluate(self, task: Dict[str, Any], agent_output: Dict[str, Any]) -> Dict[str, Any]:
        evidence = agent_output.get("retrieved_evidence", [])
        evidence_text = "\n".join(evidence) if evidence else "No evidence provided."
        
        prompt = f"""You are an impartial judge. Evaluate the following agent response by verifying its claims against the execution evidence.

Task: {task.get('description', '')}
Expected Outcome: {task.get('expected_outcome', '')}
Agent Response: {agent_output.get('response', '')}

Execution Evidence:
{evidence_text}

Step 1: Identify claims in the response that require evidence.
Step 2: Check whether the evidence supports each claim.
Step 3: Identify unsupported or contradictory claims.
Step 4: Score the response from 0 to 100 based on evidence grounding and accuracy.

Return ONLY a JSON object with: {{"score": <int>, "confidence": <float>, "evidence_validity": "valid|invalid|partial", "reasoning": "<string>"}}
"""
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json",
        }
        payload = {
            "model": self.model_name,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0.0,
            "response_format": {"type": "json_object"},
        }
        try:
            response = requests.post(self.api_url, headers=headers, json=payload, timeout=30)
            if response.status_code == 200:
                data = response.json()
                content = data["choices"][0]["message"]["content"]
                parsed = json.loads(content)
                return {
                    "judge_id": "JUDGE-EVIDENCE",
                    "task_id": task.get("task_id", "UNKNOWN"),
                    "agent_id": agent_output.get("agent_id", "UNKNOWN"),
                    "score": parsed.get("score", 50),
                    "confidence": parsed.get("confidence", 0.5),
                    "evidence_validity": parsed.get("evidence_validity", "invalid"),
                    "evaluation_status": "success",
                }
            else:
                return {
                    "judge_id": "JUDGE-EVIDENCE",
                    "task_id": task.get("task_id", "UNKNOWN"),
                    "agent_id": agent_output.get("agent_id", "UNKNOWN"),
                    "score": 50,
                    "confidence": 0.0,
                    "evidence_validity": "invalid",
                    "evaluation_status": f"api_error: {response.status_code}",
                }
        except Exception as e:
            return {
                "judge_id": "JUDGE-EVIDENCE",
                "task_id": task.get("task_id", "UNKNOWN"),
                "agent_id": agent_output.get("agent_id", "UNKNOWN"),
                "score": 50,
                "confidence": 0.0,
                "evidence_validity": "invalid",
                "evaluation_status": f"error: {e}",
            }
